# Normalize line endings — critical in a mixed Windows/JS + Java monorepo
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.jar   binary
*.class binary